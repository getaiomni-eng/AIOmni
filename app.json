{
  "expo": {
    "name": "AIOmni",
    "slug": "AIOmni",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./app-icon.png",
    "scheme": "aiomnifantasy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getaiomni.AIOmni",
      "buildNumber": "178",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "AIOmni uses your photos so you can upload trade-proposal screenshots for instant analysis.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "aiomni",
          "project": "aiomni",
          "uploadSourceMaps": false,
          "disableNativeFramesTracking": true
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/favicon.png",
          "color": "#1be7ff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "backgroundColor": "#0a0a0a",
      "resizeMode": "contain"
    },
    "backgroundColor": "#0a0a0a",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e19f333-a3e6-4b11-b162-780ac8203b50"
      }
    },
    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/images/*"
    ],
    "jsEngine": "hermes",
    "android": {
      "package": "com.getaiomni.aiomni",
      "adaptiveIcon": {
        "foregroundImage": "./app-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3e19f333-a3e6-4b11-b162-780ac8203b50"
    }
  }
}